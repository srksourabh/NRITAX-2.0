{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/filing/**",
              "components/forms/**",
              "components/ledger/**",
              "components/navigation/**",
              "ui_kits/filing_app/**",
              "ui_kits/marketing_site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Sans|IBM Plex Mono|IBM Plex Sans Devanagari))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Sans, IBM Plex Mono, IBM Plex Sans Devanagari."
      },
      {
        "selector": "JSXOpeningElement[name.name='Acknowledgement'] > JSXAttribute > JSXIdentifier[name!=/^(?:ackNumber|filedOn|regime|itrForm|figure|animate|key|ref|className|style|children)$/]",
        "message": "<Acknowledgement> doesn't accept that prop. Declared props: ackNumber, filedOn, regime, itrForm, figure, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|disabled|fullWidth|iconLeft|iconRight|children|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, disabled, fullWidth, iconLeft, iconRight, children, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|destructive|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'destructive' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|mobilePrimary|compact)$/]",
        "message": "<Button> size must be one of 'default' | 'mobilePrimary' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|interactive|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, interactive, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterBoxInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|hint|error|value|onChange|id|name|key|ref|className|style|children)$/]",
        "message": "<CharacterBoxInput> doesn't accept that prop. Declared props: kind, label, hint, error, value, onChange, id, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterBoxInput'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:pan|tan|aadhaar|ifsc)$/]",
        "message": "<CharacterBoxInput> kind must be one of 'pan' | 'tan' | 'aadhaar' | 'ifsc'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|checked|onChange|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, hint, checked, onChange, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|amount|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, header, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeadlineBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|dueDate|hoursLeft|lateFee|revisedDeadline|action|key|ref|className|style|children)$/]",
        "message": "<DeadlineBanner> doesn't accept that prop. Declared props: days, dueDate, hoursLeft, lateFee, revisedDeadline, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|children|footer|onClose|variant|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, description, children, footer, onClose, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:modal|sheet)$/]",
        "message": "<Dialog> variant must be one of 'modal' | 'sheet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ParsedField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|uncertain|key|ref|className|style|children)$/]",
        "message": "<ParsedField> doesn't accept that prop. Declared props: label, value, uncertain."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: line, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Expert'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|credential|lastActive|key|ref|className|style|children)$/]",
        "message": "<Expert> doesn't accept that prop. Declared props: name, initials, credential, lastActive."
      },
      {
        "selector": "JSXOpeningElement[name.name='Explainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:term|definition|children|key|ref|className|style|children)$/]",
        "message": "<Explainer> doesn't accept that prop. Declared props: term, definition, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilingProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|onStep|compact|key|ref|className|style|children)$/]",
        "message": "<FilingProgress> doesn't accept that prop. Declared props: steps, current, onStep, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|tone|note|size|stamp|key|ref|className|style|children)$/]",
        "message": "<HeroFigure> doesn't accept that prop. Declared props: label, amount, tone, note, size, stamp."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroFigure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|credit)$/]",
        "message": "<HeroFigure> tone must be one of 'ink' | 'credit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroFigure'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg)$/]",
        "message": "<HeroFigure> size must be one of 'xl' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|prefix|suffix|align|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, required, prefix, suffix, align, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Input> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LedgerRowSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|statute|amount|kind|head|edited|onEditRevert|key|ref|className|style|children)$/]",
        "message": "<LedgerRowSpec> doesn't accept that prop. Declared props: label, statute, amount, kind, head, edited, onEditRevert."
      },
      {
        "selector": "JSXOpeningElement[name.name='LedgerRowSpec'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:row|subtotal|final)$/]",
        "message": "<LedgerRowSpec> kind must be one of 'row' | 'subtotal' | 'final'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|value|onChange|source|onSourceClick|disabled|id|key|ref|className|style|children)$/]",
        "message": "<MoneyInput> doesn't accept that prop. Declared props: label, hint, error, required, value, onChange, source, onSourceClick, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|hint|key|ref|className|style|children)$/]",
        "message": "<RadioOption> doesn't accept that prop. Declared props: value, label, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='RegimeColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|tax|key|ref|className|style|children)$/]",
        "message": "<RegimeColumn> doesn't accept that prop. Declared props: rows, tax."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|tone|label|dot|onInk|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, tone, label, dot, onInk."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:credit|due|notice|info|primary|draft)$/]",
        "message": "<StatusPill> tone must be one of 'credit' | 'due' | 'notice' | 'info' | 'primary' | 'draft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatuteChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|source|onClick|title|key|ref|className|style|children)$/]",
        "message": "<StatuteChip> doesn't accept that prop. Declared props: children, source, onClick, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|checked|onChange|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, hint, checked, onChange, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|reference|key|ref|className|style|children)$/]",
        "message": "<TrustMark> doesn't accept that prop. Declared props: name, reference."
      }
    ]
  },
