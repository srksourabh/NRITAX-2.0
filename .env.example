# ─── Copy to web/.env.local and fill in. Nothing here is required to run the
# ─── app locally: the defaults give you a working offline demo.

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NRITAX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset and the app uses an embedded Postgres (PGlite) stored
# in web/.data — no install, no Docker. Set it to a real Postgres for production.
# DATABASE_URL="postgres://user:password@host:5432/nritax"

# ── Auth (Auth.js) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-dev-only-change-me-32b"
AUTH_URL="http://localhost:3000"

# Email magic link. Without these, a dev-only link is printed to the terminal.
# AUTH_EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# AUTH_EMAIL_FROM="NRITAX <no-reply@nritax.example>"

# Google sign-in (optional).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── ERI provider ─────────────────────────────────────────────────────────────
# mock     — fully offline, returns realistic specimen data. Default.
# sandbox  — Sandbox.co.in ERI APIs.
# quicko   — Quicko ERI APIs.
ERI_PROVIDER="mock"
# ERI_BASE_URL=""
# ERI_API_KEY=""
# ERI_API_SECRET=""
# ERI_USER_ID=""

# Departmental software identifier, issued when you register as an ERI. The
# validator refuses to pass while this is the placeholder, because Category-A
# blacklisting attaches to this number.
ERI_SOFTWARE_ID="SW00000000"

# ── CAS parsing service ──────────────────────────────────────────────────────
# The Python service in services/cas. When unreachable, statement upload is
# disabled and the wizard falls back to manual capital-gain entry.
CAS_SERVICE_URL="http://localhost:8000"
# Shared secret between web and the CAS service.
CAS_SERVICE_TOKEN="dev-cas-token"

# ── AI audit ─────────────────────────────────────────────────────────────────
# Without a key the audit step is skipped and says so; nothing else breaks.
# ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
