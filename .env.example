# ─── Copy to web/.env.local and fill in. Nothing here is required to run the
# ─── app locally: the defaults give you a working offline demo.

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NRITAX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Auth (Auth.js) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-dev-only-change-me-32b"
AUTH_URL="http://localhost:3000"

# Demo account — direct password login for testing (no email). Leave
# AUTH_DEMO_PASSWORD unset to hide the demo panel. Set AUTH_DEMO_LOGIN=0 to
# disable even when a password is present.
AUTH_DEMO_EMAIL="demo@nritax.app"
AUTH_DEMO_PASSWORD="demo1234"
# AUTH_DEMO_LOGIN="0"

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset and the app uses an embedded Postgres (PGlite) stored
# in web/.data — no install, no Docker. Set it to a real Postgres for production.
#
# On Supabase: Project Settings → Database → Connection string. Use the
# transaction pooler (6543) for DATABASE_URL and the direct connection (5432)
# for DIRECT_URL, which migrations need.
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase project keys. Not read by any code today — fill only if we adopt
# Supabase Storage or its auth. The service role key bypasses every access
# rule: server side only, never NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sends the sign-in link. Without these, a dev-only link is printed to the
# terminal. SMTP username is the literal word "resend"; the password is the API
# key. The from-address domain must be verified in Resend or mail bounces.
# RESEND_API_KEY=""
# AUTH_EMAIL_SERVER="smtp://resend:re_xxx@smtp.resend.com:587"
# AUTH_EMAIL_FROM="NRITAX <no-reply@yourdomain.com>"

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── ERI provider ─────────────────────────────────────────────────────────────
# mock     — fully offline, returns realistic specimen data. Default.
# sandbox  — reserved; Sandbox.co.in is NOT an ERI (see docs/CONTRACTS.md).
# quicko   — Quicko ERI APIs.
#
# Keep this on "mock" until a real ERI is contracted. Sandbox KYC / IFSC /
# DigiLocker / OCR enrichment still uses ERI_BASE_URL + ERI_API_KEY +
# ERI_API_SECRET below — those helpers soft-fail when unset.
ERI_PROVIDER="mock"
# ── Sandbox DigiLocker / KYC enrichment ─────────────────────────────────────
# DigiLocker live product requires:
#   1) DigiLocker enabled on your Sandbox dashboard (KYC → DigiLocker)
#   2) HTTPS redirect — DigiLocker rejects http://localhost
# DIGILOCKER_REDIRECT_URL="https://your-ngrok-or-deployed-host/filing"
#
# Until DigiLocker is enabled on the account, local consent debugging:
DIGILOCKER_MOCK="1"
# ERI_BASE_URL="https://test-api.sandbox.co.in"
# ERI_API_KEY=""
# ERI_API_SECRET=""
# ERI_USER_ID=""

# Departmental software identifier, issued when you register as an ERI. The
# validator refuses to pass while this is the placeholder, because Category-A
# blacklisting attaches to this number.
ERI_SOFTWARE_ID="SW00000000"

# ── CAS parsing service ──────────────────────────────────────────────────────
# The Python service in services/cas. When unreachable, statement upload is
# disabled and the wizard falls back to manual capital-gain entry.
CAS_SERVICE_URL="http://localhost:8000"
# Shared secret between web and the CAS service.
CAS_SERVICE_TOKEN="dev-cas-token"

# ── AI audit ─────────────────────────────────────────────────────────────────
# Without a key the audit step is skipped and says so; nothing else breaks.
# ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
